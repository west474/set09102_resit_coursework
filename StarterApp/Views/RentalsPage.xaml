<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="StarterApp.Views.RentalsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:StarterApp.ViewModels"
             xmlns:models="clr-namespace:StarterApp.Database.Models;assembly=StarterApp.Database"
             x:DataType="viewmodels:RentalsViewModel"
             Title="{Binding Title}">

<!-- generated with ChatGPT -->
    <Grid RowDefinitions="Auto,*">

        <Grid Grid.Row="0" ColumnDefinitions="*,*" Margin="10" ColumnSpacing="10">
            <Button Grid.Column="0" Text="Incoming" Command="{Binding ShowIncomingCommand}" />
            <Button Grid.Column="1" Text="Outgoing" Command="{Binding ShowOutgoingCommand}" />
        </Grid>

        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding Rentals}" SelectionMode="None">

                <CollectionView.EmptyView>
                    <Label Text="No rentals found" FontSize="18" TextColor="Gray"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Rental">
                        <Grid Padding="15,10" RowDefinitions="Auto,Auto,Auto">
                            <Label Grid.Row="0" Text="{Binding ItemTitle}" FontSize="16" FontAttributes="Bold" />
                            <Label Grid.Row="1" Text="{Binding StartDate, StringFormat='From: {0:d}'}"
                                   FontSize="14" TextColor="Gray" />
                            <Label Grid.Row="2" Text="{Binding Status}" FontSize="14" TextColor="DodgerBlue" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>